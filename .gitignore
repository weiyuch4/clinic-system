# Database — must never be committed; lives only on the clinic PC
contacts.db
auth.db
contacts_pre_*.db

# JWT secret key — generated on first run, must never be committed
auth_secret.key
backups/

# Persisted DBF parse cache (see database.py warmup_cache) — large, local, rebuildable
dbf_cache.pkl.gz

# Local config override (real IC data path goes here, not in config.py)
config_local.py

# Dedicated Chrome profile for the Alleypin LINE-notification automation —
# holds a real logged-in session, must never be committed
alleypin_profile/
alleypin_browser.pid

# Claude Code local settings
.claude/

# Mock data — not needed in production
mock/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Patient/report caches — large, local, rebuildable
base_report_cache.json
hep_patient_cache.json

# Temp files
tmp_*.txt
*.tmp

# Environment variables (contain DB credentials)
.env
